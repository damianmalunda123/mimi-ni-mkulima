# Configure SMTP to send signup codes by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Or configure Twilio to send signup codes by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# In-app expert messaging and WebRTC calls.
COMMS_DB_PATH=communications.sqlite3
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8765,http://127.0.0.1:8765,http://localhost:8000,http://127.0.0.1:8000
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
